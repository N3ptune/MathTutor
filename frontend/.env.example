# Frontend environment variables (injected at build time by Vite)
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Shown on the Terms, Privacy Policy, and contact links
VITE_SUPPORT_EMAIL=support@your-domain.com
VITE_LEGAL_ENTITY=Your Name or Company LLC
VITE_GOVERNING_LAW=the State of YOUR_STATE, United States

# Optional error reporting
VITE_SENTRY_DSN=
