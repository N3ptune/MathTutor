# Backend environment variables
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service-role key: bypasses row-level security. Needed for billing, usage limits,
# and account deletion. Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OPENAI_API_KEY=sk-your-openai-api-key

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173
# Where Stripe sends people back after checkout / the billing portal
FRONTEND_URL=http://localhost:5173

# Stripe (test-mode keys locally). Billing stays off until all three are set.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Optional
SENTRY_DSN=
ENVIRONMENT=local
# minimal | low | medium | high. Check accuracy with `python -m evals.run_grading_eval` before lowering.
GRADING_REASONING_EFFORT=medium
